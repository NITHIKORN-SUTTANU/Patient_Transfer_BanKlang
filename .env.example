# Local development only. Copy to .env and choose a local password.
POSTGRES_PASSWORD=change-local-password
DATABASE_URL=postgresql://patient_transfer:change-local-password@127.0.0.1:54329/patient_transfer
# Tests create a uniquely named temporary database using this administrative URL.
# Never point this at a production server.
DATABASE_TEST_ADMIN_URL=postgresql://patient_transfer:change-local-password@127.0.0.1:54329/patient_transfer
ALLOW_SYNTHETIC_SEED=false
API_PORT=3001
PRIVACY_NOTICE_VERSION=development-v1
# Set an approved OSRM base URL before using real schedule endpoints.
# OSRM_URL=
# FRONTEND_ORIGIN=http://localhost:5173
# Approved HTTPS origin for authenticated notification links (no credentials/path/query).
# PUBLIC_APP_URL=https://your-approved-service.example
# Current App preserves commit bf95b2e UI and its browser services.
# API wiring into those screens is pending; no flag switches to another UI.
# VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:3001
# LINE_LOGIN_CHANNEL_ID=
# LINE_LIFF_ID=
# LINE_CHANNEL_ACCESS_TOKEN=
ALLOW_LINE_DELIVERY=false
# Set the approved notice text before enabling citizen consent.
# PRIVACY_NOTICE_TEXT=
# MUNICIPAL_CONTACT_PHONE=
